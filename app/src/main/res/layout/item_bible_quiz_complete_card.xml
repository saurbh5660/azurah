<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bible_white_card_background"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_3sdp"
        android:background="#16A34A" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/_78sdp"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingVertical="@dimen/_14sdp">

        <FrameLayout
            android:id="@+id/flQuizCompleteIcon"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="@dimen/_44sdp"
            android:background="@drawable/quiz_complete_icon_outer_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="@dimen/_28sdp"
                android:layout_height="@dimen/_28sdp"
                android:layout_gravity="center"
                android:background="@drawable/quiz_complete_icon_inner_bg">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_quiz_complete_avatar" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvQuizCompleteTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="false"
            android:text="Quiz Complete!"
            android:textColor="@color/dashboard_card_text"
            android:textSize="@dimen/_13sdp"
            app:layout_constraintBottom_toTopOf="@+id/tvQuizCompleteDesc"
            app:layout_constraintEnd_toStartOf="@+id/flQuizDoneCheck"
            app:layout_constraintStart_toEndOf="@+id/flQuizCompleteIcon"
            app:layout_constraintTop_toTopOf="@+id/flQuizCompleteIcon"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tvQuizCompleteDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/inter"
            android:includeFontPadding="false"
            android:text="Come back tomorrow"
            android:textColor="@color/dashboard_subtitle"
            android:textSize="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@+id/llDoneToday"
            app:layout_constraintEnd_toStartOf="@+id/flQuizDoneCheck"
            app:layout_constraintStart_toEndOf="@+id/flQuizCompleteIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvQuizCompleteTitle" />

        <LinearLayout
            android:id="@+id/llDoneToday"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_18sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@drawable/bible_quiz_done_today_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="@+id/flQuizCompleteIcon"
            app:layout_constraintStart_toEndOf="@+id/flQuizCompleteIcon"
            app:layout_constraintTop_toBottomOf="@+id/tvQuizCompleteDesc">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/_8sdp"
                android:layout_height="@dimen/_8sdp"
                android:src="@drawable/ic_quiz_done_today_check" />

            <TextView
                android:id="@+id/tvDoneToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_3sdp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="Done today"
                android:textColor="#166534"
                android:textSize="@dimen/_8sdp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/flQuizDoneCheck"
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#22C55E"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tvQuizDoneCheck"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_streak_check_white" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
