                        app:strokeColor="#EAEAEA"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="@dimen/_60sdp"
                            android:layout_height="@dimen/_24sdp" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_8sdp"
                        app:cardBackgroundColor="@color/cp_divider_color"
                        app:cardCornerRadius="@dimen/_20sdp"
                        app:strokeColor="#EAEAEA"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="@dimen/_90sdp"
                            android:layout_height="@dimen/_24sdp" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_8sdp"
                        app:cardBackgroundColor="@color/cp_divider_color"
                        app:cardCornerRadius="@dimen/_20sdp"
                        app:strokeColor="#EAEAEA"
                        app:strokeWidth="1dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="@dimen/_80sdp"
                            android:layout_height="@dimen/_24sdp" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clVisitWeb1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_120sdp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="@dimen/_8sdp"
                    app:layout_constraintTop_toBottomOf="@+id/clSearch1"
                    android:layout_marginHorizontal="@dimen/_16sdp">

                    <com.makeramen.roundedimageview.RoundedImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/shop_image"
                        android:adjustViewBounds="true"
                        app:riv_corner_radius="@dimen/_16sdp"
                        android:scaleType="centerCrop"/>

                    <TextView
                        android:id="@+id/tvShopNow1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:fontFamily="@font/urbanist_semibold"
                        android:text="@string/shop_now"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <TextView
                        android:id="@+id/tvNowProducts1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/urbanist"
                        android:text="@string/now_in_product"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvShopNow1" />

                    <TextView
                        android:id="@+id/tvAllColours1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_16sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:fontFamily="@font/urbanist"
                        android:text="@string/all_colours"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9sdp"
