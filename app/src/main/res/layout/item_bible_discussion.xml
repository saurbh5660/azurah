<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_14sdp"
    android:layout_marginTop="@dimen/_10sdp"
    android:background="@drawable/discussion_comment_card"
    android:elevation="@dimen/_1sdp"
    android:orientation="vertical"
    android:padding="@dimen/_14sdp">

    <TextView
        android:id="@+id/tvStudyMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:includeFontPadding="false"
        android:letterSpacing="0.08"
        android:textColor="@color/dashboard_subtitle"
        android:textSize="@dimen/_9sdp"
        tools:text="ESTHER • DAY 5 • QUESTION 1 OF 2" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/inter_bold"
        android:includeFontPadding="false"
        android:textColor="@color/dashboard_card_text"
        android:textSize="@dimen/_14sdp"
        tools:text="What stood out to you in today's reading?" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/inter"
        android:includeFontPadding="false"
        android:textColor="@color/dashboard_card_text"
        android:textSize="@dimen/_12sdp"
        tools:text="Lorem Ipsum is simply dummy text..." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/llCommentDiscussion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp">

            <ImageView
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_discussion_reply"
                app:tint="@color/dashboard_subtitle" />

            <TextView
                android:id="@+id/tvResponseCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/inter"
                android:includeFontPadding="false"
                android:textColor="@color/dashboard_subtitle"
                android:textSize="@dimen/_11sdp"
                tools:text="23 responses" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llLikeDiscussion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="@dimen/_4sdp"
            android:layout_marginStart="@dimen/_10sdp">

            <ImageView
                android:id="@+id/ivLike"
                android:layout_width="@dimen/_14sdp"
                android:layout_height="@dimen/_14sdp"
                android:contentDescription="@null"
                android:src="@drawable/unselected_heart"
                app:tint="@color/dashboard_subtitle" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/inter"
                android:includeFontPadding="false"
                android:textColor="@color/dashboard_subtitle"
                android:textSize="@dimen/_11sdp"
                tools:text="47 likes" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
