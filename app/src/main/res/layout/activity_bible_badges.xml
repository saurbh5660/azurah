<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/badgesRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/badges_header_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingBottom="@dimen/_22sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tvBack"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:gravity="center"
                android:src="@drawable/back_button1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cinzel_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:text="AZRIUS"
                android:textColor="@color/white"
                android:textSize="@dimen/_18sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.12"
            android:text="YOUR CURRENT BADGE"
            android:textColor="#D4E6F2"
            android:textSize="@dimen/_9sdp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivHeaderBadge"
            android:layout_width="@dimen/_130sdp"
            android:layout_height="@dimen/_130sdp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_6sdp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/bible_badge" />

        <TextView
            android:id="@+id/tvCurrentBadgeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cinzel_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Beginner"
            android:textColor="@color/white"
            android:textSize="@dimen/_24sdp" />

        <TextView
            android:id="@+id/tvCurrentBadgeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="Keep building your streak to unlock higher badges"
            android:textColor="#E8F3FA"
            android:textSize="@dimen/_11sdp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginTop="@dimen/_16sdp"
            android:background="@drawable/badges_progress_track"
            android:orientation="horizontal"
            android:weightSum="100">

            <View
                android:id="@+id/vProgressActive"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="10"
                android:background="@drawable/badges_progress_active" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProgressStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:text="BEGINNER — 0 DAYS"
                android:textColor="#A8C8DC"
                android:textSize="@dimen/_8sdp" />

            <TextView
                android:id="@+id/tvProgressEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:includeFontPadding="false"
                android:text="SEED — 7 DAYS"
                android:textColor="#A8C8DC"
                android:textSize="@dimen/_8sdp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/badges_content_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingTop="@dimen/_18sdp"
            android:paddingBottom="@dimen/_28sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/cinzel_bold"
                    android:includeFontPadding="false"
                    android:text="Your Badges"
                    android:textColor="#0D3B66"
                    android:textSize="@dimen/_18sdp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Tap any badge for more info"
                    android:textColor="#B0B8C1"
                    android:textSize="@dimen/_9sdp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_18sdp"
                android:background="@drawable/badges_how_card"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="HOW TO EARN BADGES"
                    android:textColor="@color/blue"
                    android:textSize="@dimen/_9sdp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#EAF4FF"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvHowOne"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/inter"
                        android:textColor="@color/dashboard_card_text"
                        android:textSize="@dimen/_11sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#EAF4FF"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvHowTwo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:includeFontPadding="false"
                        android:textColor="@color/dashboard_card_text"
                        android:textSize="@dimen/_11sdp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="@dimen/_24sdp"
                        android:layout_height="@dimen/_24sdp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#EAF4FF"
                        android:fontFamily="@font/inter_bold"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/blue"
                        android:textSize="@dimen/_10sdp" />

                    <TextView
                        android:id="@+id/tvHowThree"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:fontFamily="@font/inter"
                        android:includeFontPadding="false"
                        android:textColor="@color/dashboard_card_text"
                        android:textSize="@dimen/_11sdp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
