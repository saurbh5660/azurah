<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_13sdp">

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="@dimen/_22sdp"
        android:layout_height="@dimen/_22sdp"
        android:background="@drawable/circle_background"
        android:backgroundTint="#E9F7FF"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:text="1"
        android:textColor="#007BB5"
        android:textSize="@dimen/_8sdp"
        android:includeFontPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:fontFamily="@font/inter_bold"
        android:text="What stood out to you?"
        android:textColor="@color/black"
        android:textSize="@dimen/_13sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvNumber"
        app:layout_constraintTop_toTopOf="@+id/tvNumber" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:fontFamily="@font/inter"
        android:text="What moment in today's reading&#10;challenged or encouraged you most?"
        android:textColor="#77849E"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvNumber"
        app:layout_constraintTop_toBottomOf="@+id/tvQuestion" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_28sdp"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/_34sdp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="@dimen/_12sdp"
            android:layout_height="@dimen/_12sdp"
            android:src="@drawable/comment_icon1"/>

        <TextView
            android:id="@+id/tvResponses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/_4sdp"
            android:text="23 responses"
            android:textColor="#9AA8B8"
            android:textSize="@dimen/_11sdp"
            />

    </LinearLayout>



    <TextView
        android:id="@+id/tvDiscuss"
        android:layout_width="@dimen/_82sdp"
        android:layout_height="@dimen/_30sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:background="@drawable/bible_discuss_button_background"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:text="Discuss →"
        android:textColor="@color/white"
        android:textSize="@dimen/_12sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvDesc" />
</androidx.constraintlayout.widget.ConstraintLayout>
